# ========================================================================
# C2M API Environment Configuration Template
# ========================================================================
# Copy this file to .env and add your Postman API key
# See Getting Started documentation for setup instructions
# ========================================================================

# Team Workspace (C2M) - Used for team collaboration and CI/CD
POSTMAN_C2M_API_KEY=your-team-postman-api-key-here

# ── Postman Workspace UIDs ──────────────────────────────────────────────────
# These default to the values in the Makefile.  Override here if you're
# pointing at a different Postman organisation or personal account.
# SERRAO_WS=d8a1f479-a2aa-4471-869e-b12feea0a98c
# C2M_WS=c740f0f4-0de2-4db3-8ab6-f8a0fa6fbeb1
