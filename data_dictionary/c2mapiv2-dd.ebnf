(* token is Encrypted payment token from Google Pay *)

(* ================================================================
   SUCCESS RESPONSE SCHEMAS
   ================================================================ *)

(* Standard Success Response - returned for all successful job submissions *)
(* @doc Success response returned for all successful job submissions. *)
standardResponse = status + message + requestId ;

(* @doc Job status string (e.g. "accepted"). *)
status = string ;    (* e.g. "accepted" *)
(* @doc Human-readable confirmation message (e.g. "Your request has been queued"). *)
message = string ;   (* Human-readable confirmation, e.g. "Your request has been queued" *)

(* ================================================================
   ERROR RESPONSE SCHEMAS
   ================================================================ *)

(* Standard Error Response - returned for all error conditions *)
(* @doc Error response structure returned for all API error conditions. *)
errorResponse =
      errorType
    + errorMessage
    + errorCode
    + [ errorDetails ]
    + [ errorTrackingId ] ;

(* @doc High-level error category string (ValidationError, AuthenticationError, etc.). *)
errorType = "ValidationError"
          | "AuthenticationError"
          | "AuthorizationError"
          | "ResourceNotFoundError"
          | "RateLimitError"
          | "ServerError" ;

(* @doc Human-readable error description. *)
errorMessage = string ;  (* Human-readable error description *)

(* @doc Machine-readable error code string (e.g. MISSING_REQUIRED_FIELD). *)
errorCode = "MISSING_REQUIRED_FIELD"
          | "INVALID_ONEOF"
          | "INVALID_JSON"
          | "MISSING_AUTH_HEADER"
          | "INVALID_TOKEN"
          | "EXPIRED_TOKEN"
          | "INSUFFICIENT_PERMISSIONS"
          | "ACCOUNT_SUSPENDED"
          | "JOB_NOT_FOUND"
          | "RESOURCE_NOT_FOUND"
          | "INVALID_ENUM_VALUE"
          | "MUTUAL_EXCLUSION_VIOLATION"
          | "INVALID_FORMAT"
          | "SERVER_ERROR"
          | "DATABASE_ERROR"
          | "EXTERNAL_SERVICE_ERROR"
          | "RATE_LIMIT_EXCEEDED" ;

(* @doc Optional JSON object with additional error context (free-form key/value pairs). *)
errorDetails = string ;  (* JSON object with error context - additionalProperties in OpenAPI *)

(* @doc Optional support tracking identifier in the format TRK-YYYYMMDD-XXXXXX. *)
errorTrackingId = string ;  (* Optional request ID for support tracking - format: TRK-YYYYMMDD-XXXXXX *)

(* HTTP Error Response Aliases *)
HTTP_400_BAD_REQUEST = errorResponse ;
HTTP_401_UNAUTHORIZED = errorResponse ;
HTTP_403_FORBIDDEN = errorResponse ;
HTTP_404_NOT_FOUND = errorResponse ;
HTTP_422_UNPROCESSABLE_ENTITY = errorResponse ;
HTTP_429_TOO_MANY_REQUESTS = errorResponse ;
HTTP_500_INTERNAL_SERVER_ERROR = errorResponse ;

(* ----------------------------------------------------------------
   HTTP STATUS → ERROR MAPPING
   Declares which errorType and errorCodes apply for each HTTP status.
   Edit this block (not the Python scripts) to change which error
   variants are produced in the OpenAPI spec and Postman collections.
   Both ebnf_to_openapi_dynamic_v3.py and add_response_examples.py
   read this block at build time via the x-http-error-map spec extension.
   ----------------------------------------------------------------
   @http_error_map
   400: errorType=ValidationError; errorCodes=MISSING_REQUIRED_FIELD,INVALID_ONEOF,INVALID_JSON
   401: errorType=AuthenticationError; errorCodes=MISSING_AUTH_HEADER,INVALID_TOKEN,EXPIRED_TOKEN
   403: errorType=AuthorizationError; errorCodes=INSUFFICIENT_PERMISSIONS,ACCOUNT_SUSPENDED
   404: errorType=ResourceNotFoundError; errorCodes=JOB_NOT_FOUND,RESOURCE_NOT_FOUND
   422: errorType=ValidationError; errorCodes=INVALID_ENUM_VALUE,MUTUAL_EXCLUSION_VIOLATION,INVALID_FORMAT
   429: errorType=RateLimitError; errorCodes=RATE_LIMIT_EXCEEDED
   500: errorType=ServerError; errorCodes=SERVER_ERROR,DATABASE_ERROR,EXTERNAL_SERVICE_ERROR
   @end_http_error_map *)

(* ----------------------------------------------------------------
   NUMERIC CONSTRAINTS
   Declares minimum/maximum bounds for integer fields.
   Parsed by ebnf_to_openapi_dynamic_v3.py at build time.
   Format: fieldName: minimum=N, maximum=N
   (exclusiveMinimum and exclusiveMaximum are also supported)
   ----------------------------------------------------------------
   @numeric_constraints
   month: minimum=1, maximum=12
   year: minimum=2000, maximum=2099
   quantity: minimum=1
   startPage: minimum=1
   endPage: minimum=1
   @end_numeric_constraints *)

(* ----------------------------------------------------------------
   MUTUAL EXCLUSION
   Fields that are mutually exclusive per request — only one may be
   sent at a time.  Parsed by ebnf_to_openapi_dynamic_v3.py and
   emitted as x-mutual-exclusion in the OpenAPI spec info block.
   Format: comma-separated field names on a single line.
   ----------------------------------------------------------------
   @mutual_exclusion jobTemplate, jobOptions
   @end_mutual_exclusion *)

(* ----------------------------------------------------------------
   VALID COMBINATIONS
   Documents which combinations of jobOptions fields are valid
   together.  Parsed by ebnf_to_openapi_dynamic_v3.py and emitted
   as x-valid-combinations in the OpenAPI spec info block.
   Format: fieldA=value: fieldB must be one of (v1|v2|...)
   ----------------------------------------------------------------
   @valid_combinations
   color=black_and_white: paperType must be one of (white|white_24|ivory)
   mailClass=non_profit: documentClass must be one of (letter|flat)
   envelope=none: layout must be one of (address_on_first_page|address_on_back_page)
   @end_valid_combinations *)
