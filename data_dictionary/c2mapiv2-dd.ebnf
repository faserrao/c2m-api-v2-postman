(* ============================================================================
   EBNF PRIMER (READ THIS FIRST)
   ============================================================================

   This file is an EBNF “data dictionary” that describes the JSON request bodies
   for the simplified C2M Jobs submission endpoints under:

     POST /jobs/submit/...

   If you have never seen EBNF before, think of it as a compact way to describe
   “what fields can appear” and “how those fields can be combined”.

   ----------------------------------------------------------------------------
   1) Big picture: how this file is used
   ----------------------------------------------------------------------------
   - EBNF is the SOURCE OF TRUTH in the pipeline.
   - A translator converts this EBNF into an OpenAPI (YAML) specification.
   - The generated OpenAPI can then be imported into tools like Postman and used
     to generate tests once examples are added.

   So the EBNF defines structure; OpenAPI is a generated artifact.

   ----------------------------------------------------------------------------
   2) What a rule is
   ----------------------------------------------------------------------------
   A rule looks like:

     ruleName = something ;

   - 'ruleName' is the name of the concept being defined.
   - '=' means “is defined as”.
   - ';' ends the rule.

   Example:
     id = integer ;

   Means: wherever 'id' is used, it is an integer.

   ----------------------------------------------------------------------------
   3) How we represent JSON objects in this dialect
   ----------------------------------------------------------------------------
   This file follows the style used by the existing (old) data dictionary that
   your CI/CD translator already understands:

   - We do NOT write literal JSON punctuation (no '{', '}', ':', or quoted field
     names).
   - Instead, each JSON “field” is modeled as its own rule (e.g., address1),
     and objects are modeled by combining fields with '+'.

   Example:
     returnAddress = firstName + lastName + address1 + city + state + zip + country ;

   Read as: returnAddress contains firstName, lastName, address1, city, state, zip, country.

   Important: the EBNF describes the set/shape of fields, while the generated
   OpenAPI expresses them as JSON object properties.

   ----------------------------------------------------------------------------
   4) Combining fields with '+'
   ----------------------------------------------------------------------------
   In this data dictionary:

     A + B + C

   Means: the object contains A, B, and C.

   This is object “composition” (think: required fields) rather than arithmetic.

   ----------------------------------------------------------------------------
   5) Optional fields: [ ... ]
   ----------------------------------------------------------------------------
   Square brackets mean OPTIONAL.

     [ foo ]

   Means: foo may appear, or it may be omitted.

   Example:
     requestIdSource = requestId + [ filename ] ;

   Read as: requestIdSource must include requestId, and may include filename.

   ----------------------------------------------------------------------------
   6) Alternatives: A | B
   ----------------------------------------------------------------------------
   The vertical bar means "one of these alternatives".

     docSourceStandard = documentIdSource | requestIdSource | urlSource ;

   Read as: docSourceStandard can be provided in exactly one of these modes.

   In OpenAPI this often becomes a 'oneOf' (depending on translator behavior).

   ----------------------------------------------------------------------------
   7) Repetition / arrays: { ... }
   ----------------------------------------------------------------------------
   Curly braces mean repetition (zero or more) in standard EBNF.

     { item }

   Means: 0..N occurrences of item.
   In JSON terms, we use this to represent arrays/lists.

   Example:
     addressList = { address } ;

   Read as: addressList is a list of addresses.

   Note: This dialect typically does not encode “at least one” (1..N) directly.
   If the API requires at least one entry, that constraint is enforced by:
   - API validation, and/or
   - additional OpenAPI constraints (minItems), if your translator supports them.

   ----------------------------------------------------------------------------
   8) Endpoint request bodies: submit...Params
   ----------------------------------------------------------------------------
   Each endpoint has a rule named like:

     submitSingleDocParams = ... ;

   This rule defines the JSON body shape for that endpoint. It is built from the
   shared building blocks (docSourceAll, recipientAddressSource, etc.).

   Example:
     submitSingleDocParams =
           [ jobTemplate ]
         + docSourceAll
         + recipientAddressSource
         + [ paymentDetails ]
         + ... ;

   Read as: the request body includes the required parts, plus optional parts.

   ----------------------------------------------------------------------------
   9) Primitive types used here
   ----------------------------------------------------------------------------
   - string  : a JSON string
   - integer : a JSON integer
   - id      : an alias for integer, used when the integer is an ID

   ----------------------------------------------------------------------------
   10) What EBNF does NOT capture by itself
   ----------------------------------------------------------------------------
   EBNF is great at describing structure, but some business rules are not fully
   represented here (or may not be representable in your translator), such as:
   - “filename is required only if multiple files were uploaded”
   - “jobs[] must have at least one element”
   - “for endpoint X, recipientAddressSource must be present/absent”
   Those are enforced by endpoint-level rules and server-side validation, and
   can also be expressed in OpenAPI once examples/constraints are added.

   ============================================================================ *)


(* C2M Jobs Submission API - Data Dictionary (EBNF)
   Source: Data lead proposal (Dec 02 2025) for simplified /jobs/submit/... endpoints.
   Purpose: EBNF is the source of truth; EBNF -> OpenAPI (YAML) is generated in CI/CD.

   This file is intentionally written to match the EBNF style used in c2mapiv2-dd.ebnf (old endpoints):
     - rules use '='
     - object composition uses '+'
     - optional fields use '[ ... ]'
     - arrays use '{ ... }'
     - rules terminate with ';'

   Conventions:
     - Endpoint param sets (submit...Params) represent the JSON request body shape for that endpoint.
     - Each 'Params' rule is composed from reusable building blocks (document source variants, recipientAddressSource, etc.).
     - Optional fields are wrapped in [ ... ].
     - Arrays are represented as { item }.
*)


(***********************************)
(*        ENDPOINT DEFINITIONS      *)
(***********************************)

(* ------------------------------------------------------------------------- *)
(* Endpoint: POST /jobs/submit/single/doc                                              *)
(* ------------------------------------------------------------------------- *)

(* English meaning:
   - Body MAY include jobTemplate (preferred options selector).
   - Body MUST include `docSourceAll` (document source).
     `docSourceAll` can be:
       - documentIdSource (documentId): References a stored document by ID
       - requestIdSource (requestId + [filename]): References an uploaded file from a previous upload request
       - urlSource (url): URL to fetch document from external source
       - zipDocumentIdSource (zipDocumentId + filename): References a file within a stored zip archive
       - zipRequestIdSource (requestId + zipFilename + filename): References a file within an uploaded zip archive

     *** Mahesh: Can this endpoint be called with zipDocumentIdSource and zipRequestIdSource??

   - Body MUST include recipientAddressSource (single address OR list OR stored list).
     recipientAddressSource can be:
       - (mappingId + singleAddress [+addressName]): Single recipient with mapping
       - (mappingId + addressList [+addressListName]): List of recipients with mapping
       - addressListId: Reference to stored address list
     Note: mappingId is optional. If omitted, the server will use the default mapping ID.
   - Body MAY include paymentDetails, returnAddress, jobOptions, tags.
*)

(* Decision / validation rules (implementation-required):
   Document source (docSourceAll):
     IF docSourceAll is documentIdSource (documentId)
       THEN resolve stored document by documentId.
     ELSE IF docSourceAll is requestIdSource (requestId [+filename])
       THEN lookup upload request by requestId.
            IF upload request contains > 1 file
              THEN filename MUST be provided and MUST match a file in that request.
            ELSE filename MAY be omitted.
     ELSE IF docSourceAll is urlSource (url)
       THEN fetch document from url; reject if fetch fails or content-type not allowed.
     ELSE IF docSourceAll is zipDocumentIdSource (zipDocumentId + filename)
       THEN resolve zip archive by zipDocumentId; filename MUST exist in zip.
     ELSE IF docSourceAll is zipRequestIdSource (requestId + zipFilename + filename)
       THEN resolve upload request by requestId; zipFilename MUST identify the uploaded zip;
            filename MUST exist in that zip.
     ELSE reject (no supported docSourceAll variant).

   Recipient source (recipientAddressSource):
     IF recipientAddressSource is addressListId
       THEN load stored list by addressListId.
     ELSE IF recipientAddressSource is ([mappingId] + singleAddress [+addressName])
       THEN treat as single-recipient source; validate required address fields per product rules.
            IF mappingId is omitted
              THEN use server default mapping ID for merge-variable mapping.
            ELSE apply provided mappingId for merge-variable mapping.
     ELSE IF recipientAddressSource is ([mappingId] + addressList [+addressListName])
       THEN validate addressList has >= 1 entry.
            IF mappingId is omitted
              THEN use server default mapping ID for merge-variable mapping.
            ELSE apply provided mappingId for merge-variable mapping.
     ELSE reject (no supported recipientAddressSource variant).

   jobTemplate vs jobOptions:
     IF jobTemplate is present AND jobOptions is present
       THEN enforce policy (recommended: reject as mutually exclusive to avoid ambiguity).
     ELSE IF jobTemplate absent AND jobOptions absent
       THEN enforce defaults or reject (policy decision).

   Payment:
     IF paymentDetails present
       THEN exactly one payment variant must be used.
            ApplePay / GooglePay variants are excluded for initial testing (commented out).
*)

submitSingleDocParams =
      [ jobTemplate ]
    + docSourceAll
    + recipientAddressSource
    + [ paymentDetails ]
    + [ returnAddress ]
    + [ jobOptions ]
    + [ tags ] ;

(* ------------------------------------------------------------------------- *)
(* Endpoint: POST /jobs/submit/single/pdf/addressCapture                               *)
(* ------------------------------------------------------------------------- *)

(* English meaning:
   - Body MAY include jobTemplate.
   - Body MUST include `docSourceStandard` (document source - non-zip variants only).
     `docSourceStandard` can be: documentIdSource, requestIdSource, or urlSource (zip sources not allowed for this endpoint).
   - Body MAY include paymentDetails, returnAddress, jobOptions, tags.
   - Body does NOT include recipientAddressSource because addresses are captured
     via OCR/address extraction workflow after document upload, not provided in request body.
*)

(* Decision / validation rules (implementation-required):
   Address capture constraint:
     IF request body includes recipientAddressSource (directly or nested)
       THEN reject (this endpoint relies on address capture workflow, not inline addresses).

   Document source:
     Apply the same docSourceStandard resolution rules as /jobs/submit/single/doc.

   Job list constraint:
     IF request body includes jobs
       THEN reject (this endpoint is not a split/bulk endpoint).

   jobTemplate vs jobOptions:
     Apply the same mutual-exclusion/default policy as /jobs/submit/single/doc.

   Payment:
     Same paymentDetails rules as /jobs/submit/single/doc (Apple/Google excluded).
*)

submitSinglePdfAddressCaptureParams =
      [ jobTemplate ]
    + docSourceStandard
    + [ paymentDetails ]
    + [ returnAddress ]
    + [ jobOptions ]
    + [ tags ] ;


(* ------------------------------------------------------------------------- *)
(* Endpoint: POST /jobs/submit/single/pdf/split                                         *)
(* ------------------------------------------------------------------------- *)

(* English meaning:
   - Body MAY include jobTemplate.
   - Body MUST include `docSourceStandard` (the PDF to split).
   - Body MUST include `pdfSplitJobsWithAddress` (list of page ranges with recipient addresses).
   - Each `pdfSplitJobsWithAddress[]` entry is a `pdfSplitJobItemWithAddress` containing:
       startPage (integer) + endPage (integer) + recipientAddressSource (address reference)
   - Body MAY include paymentDetails, returnAddress, jobOptions, tags.
*)

(* Decision / validation rules (implementation-required):
   Document type constraint:
     Resolve docSourceStandard.
     IF resolved document is not a PDF
       THEN reject.

   pdfSplitJobsWithAddress constraint:
     IF pdfSplitJobsWithAddress missing OR pdfSplitJobsWithAddress has 0 entries
       THEN reject.

   Per job item constraint:
     FOR EACH pdfSplitJobsWithAddress[i]:
       IF pdfSplitJobsWithAddress[i] is not a pdfSplitJobItemWithAddress shape
         THEN reject (only pdfSplitJobItemWithAddress allowed; multiDocJobItem and pdfSplitJobItemNoAddress not allowed).
       IF startPage missing OR endPage missing
         THEN reject.
       IF startPage < 1 OR endPage < 1
         THEN reject.
       IF startPage > endPage
         THEN reject.
       IF recipientAddressSource missing
         THEN reject (required for /single/pdf/split).
*)

submitSinglePdfSplitParams =
      docSourceStandard   (* choose, see below *)
    + pdfSplitJobsWithAddress
    + [ paymentDetails ]
    + [ returnAddress ]
    + [ jobOptions ]
    + [ tags ] ;


(* ------------------------------------------------------------------------- *)
(* Endpoint: POST /jobs/submit/single/pdf/split/addressCapture                          *)
(* ------------------------------------------------------------------------- *)

(* English meaning:
   - Same as /single/pdf/split, but recipient addresses are captured externally.
   - Body MAY include jobTemplate.
   - Body MUST include `docSourceStandard`.
   - Body MUST include `pdfSplitJobsNoAddress` (list of page ranges without addresses).
   - Each `pdfSplitJobsNoAddress[]` entry is a `pdfSplitJobItemNoAddress` containing:
       startPage (integer) + endPage (integer)
   - Body MAY include paymentDetails, returnAddress, jobOptions, tags.

   Implementation note:
   - This DD models pdfSplitJobItem with [ recipientAddressSource ] (optional).
     Endpoint-level validation differentiates required/omitted usage per path.
*)

(* Decision / validation rules (implementation-required):
   Document type constraint:
     Resolve docSourceStandard.
     IF resolved document is not a PDF
       THEN reject.

   pdfSplitJobsNoAddress constraint:
     IF pdfSplitJobsNoAddress missing OR pdfSplitJobsNoAddress has 0 entries
       THEN reject.

   Per job item constraint:
     FOR EACH pdfSplitJobsNoAddress[i]:
       IF pdfSplitJobsNoAddress[i] is not a pdfSplitJobItemNoAddress shape
         THEN reject.
       Validate startPage/endPage same as /single/pdf/split.
       IF recipientAddressSource is present
         THEN reject (addresses must be captured externally for this endpoint).
*)

submitSinglePdfSplitAddressCaptureParams =
      [ jobTemplate ]
    + docSourceStandard
    + pdfSplitJobsNoAddress
    + [ paymentDetails ]
    + [ returnAddress ]
    + [ jobOptions ]
    + [ tags ] ;


(* ------------------------------------------------------------------------- *)
(* Endpoint: POST /jobs/submit/multi/doc                                                *)
(* ------------------------------------------------------------------------- *)

(* English meaning:
   - Submits multiple jobs in one request.
   - Body MAY include a top-level jobTemplate.
   - Body MUST include `multiDocJobs` (list of job items).
   - Each `multiDocJobs[]` item is a `multiDocJobItem` containing:
       [ jobTemplate ] + docSourceAll + recipientAddressSource
     where per-job jobTemplate is optional when top-level jobTemplate is present.
   - Body MAY include paymentDetails and tags.
*)

(* Decision / validation rules (implementation-required):
   multiDocJobs constraint:
     IF multiDocJobs missing OR multiDocJobs has 0 entries
       THEN reject.

   Allowed job item shape:
     FOR EACH multiDocJobs[i]:
       IF multiDocJobs[i] is not a multiDocJobItem shape
         THEN reject (pdfSplitJobItem not allowed).

   jobTemplate scoping:
     IF top-level jobTemplate present:
       THEN it applies to all multiDocJobs by default.
            IF a job item also includes jobTemplate:
              THEN enforce policy (allow per-job override OR reject; choose and document).
     ELSE (no top-level jobTemplate):
       THEN each job MUST include jobTemplate OR server must supply a default; otherwise reject.

   Document and recipient rules:
     FOR EACH multiDocJobs[i]:
       Resolve multiDocJobs[i].docSourceAll using the same rules as /single/doc.
       Resolve multiDocJobs[i].recipientAddressSource using the same rules as /single/doc.
*)

submitMultiDocParams =
    multiDocJobs
    + [ paymentDetails ]
    + [ tags ] ;


(* ------------------------------------------------------------------------- *)
(* Endpoint: POST /jobs/submit/multi/doc/merge                                          *)
(* ------------------------------------------------------------------------- *)

(* English meaning:
   - Merges multiple documents then submits the merged result as one job.
   - Body MAY include jobTemplate.
   - Body MUST include mergeDocumentSource (documentsToMerge[]).
   - Body MUST include recipientAddressSource.
   - Body MAY include paymentDetails, returnAddress, jobOptions, tags.
*)

(* Decision / validation rules (implementation-required):
   Merge list constraint:
     IF documentsToMerge missing OR documentsToMerge has 0 entries
       THEN reject.
     (Recommended) IF documentsToMerge has 1 entry
       THEN reject or treat as non-merge (policy decision; recommend reject to avoid confusion).

   Per merge ref:
     FOR EACH mergeDocumentRef in documentsToMerge:
       IF mergeDocumentRef is documentId
         THEN resolve stored document.
       ELSE IF mergeDocumentRef is requestId [+filename]
         THEN apply multi-file rule: filename required when upload request has >1 file.
       ELSE reject.

   Output constraint:
     IF merged output exceeds size/page limits
       THEN reject.

   Recipient:
     recipientAddressSource is REQUIRED and must resolve using /single/doc rules.
*)

submitMultiDocMergeParams =
      [ jobTemplate ]
    + mergeDocumentSource
    + recipientAddressSource
    + [ paymentDetails ]
    + [ returnAddress ]
    + [ jobOptions ]
    + [ tags ] ;


(* ------------------------------------------------------------------------- *)
(* Endpoint: POST /jobs/submit/multi/zip                                                *)
(* ------------------------------------------------------------------------- *)

(* English meaning:
   - Submits multiple jobs from a single ZIP file.
   - Body MUST include docSourceZipFileRef (specifies which zip file - requestId or documentId only, no filename).
   - Body MUST include `multiZipJobs` (list of job items).
   - Each `multiZipJobs[]` item is a `multiZipJobItem` containing:
       [ jobTemplate ] + filename + recipientAddressSource
   - Each job can have its own jobTemplate, specifies which file within the zip, and recipient address.
   - Body MAY include paymentDetails and tags.
*)

(* Decision / validation rules (implementation-required):
   multiZipJobs constraint:
     IF multiZipJobs missing OR multiZipJobs has 0 entries
       THEN reject.

   Allowed job item shape:
     FOR EACH multiZipJobs[i]:
       IF multiZipJobs[i] is not a multiZipJobItem shape
         THEN reject.

   Zip policy:
     This endpoint is modeled as ZIP-ONLY in the grammar via:
       submitMultiZipParams requires docSourceZipFileRef (zip file reference at top-level)
       multiZipJobItem = [ jobTemplate ] + filename + recipientAddressSource ;

     The zip file is specified once at top-level via docSourceZipFileRef:
       - zipDocumentIdOnly (documentId only, no filename), OR
       - zipRequestIdOnly (requestId only, no filename)
     Each job item then specifies:
       - Optional jobTemplate (or inherits default if not specified)
       - filename (which file within the zip)
       - recipientAddressSource (who receives it)

     Implementation should still validate:
       IF multiZipJobs[i] uses zipRequestIdSource:
         THEN zipFilename MUST identify a zip file within that upload request.
       IF multiZipJobs[i] uses zipDocumentIdSource:
         THEN filename MUST exist inside the referenced zipDocumentId.

   jobTemplate scoping:
     Same as /jobs/submit/multi/doc.
*)

submitMultiZipParams =
      docSourceZipFileRef
    + multiZipJobs
    + [ paymentDetails ]
    + [ tags ] ;


(* ------------------------------------------------------------------------- *)
(* Endpoint: POST /jobs/submit/multi/zip/addressCapture                                 *)
(* ------------------------------------------------------------------------- *)

(* English meaning:
   - Zip-based submission where addresses are captured externally.
   - Body MAY include jobTemplate.
   - Body MUST include zipDocumentSource (zip-only; equivalent to docSourceZipFile).
   - Body MAY include paymentDetails, returnAddress, jobOptions, tags.
   - Body does NOT include recipientAddressSource because address capture occurs
     outside this JSON body.
*)

(* Decision / validation rules (implementation-required):
   Address capture constraint:
     IF request body includes recipientAddressSource (directly or nested)
       THEN reject.

   Zip-only constraint:
     zipDocumentSource is defined as:
       zipDocumentIdSource | zipRequestIdSource
     (equivalent to docSourceZipFile).

     So the schema already prevents non-zip variants. Implementation should still validate:
       - the zip exists / is accessible
       - zipFilename (for zipRequestIdSource) identifies a zip within the upload request
       - filename (for both zip modes where present) selects a real file inside the zip.

     IF using zipRequestIdSource:
       THEN zipFilename MUST identify a zip file within the upload request.
            filename (inner file) selection is not provided at top-level here,
            so processing MUST define how the server selects files/jobs from the zip
            (e.g., implicit enumeration, metadata inside zip, or subsequent capture step).

   Job list constraint:
     IF request body includes multiDocJobs OR multiZipJobs OR pdfSplitJobsWithAddress OR pdfSplitJobsNoAddress (i.e., any jobs array)
       THEN reject.

   jobTemplate vs jobOptions:
     Apply the same mutual-exclusion/default policy as /single/doc.
*)

submitMultiZipAddressCaptureParams =
      [ jobTemplate ]
    + zipDocumentSource
    + [ paymentDetails ]
    + [ returnAddress ]
    + [ jobOptions ]
    + [ tags ] ;


(***********************************)
(*           CORE OBJECTS           *)
(***********************************)

jobTemplate = string ;

returnAddress =
      firstName + lastName
    + [ company ]
    + address1
    + city + state + zip + country
    + [ address2 ] + [ address3 ] ;

jobOptions =
      documentClass
    + layout
    + productionTime
    + envelope
    + color
    + paperType
    + printOption
    + mailClass ;

documentClass  = string ;
layout         = string ;
productionTime = string ;
envelope       = string ;
color          = string ;
paperType      = string ;
printOption    = string ;
mailClass      = string ;

tags = tagsList ;
tagsList = { string } ;

(***********************************)
(*          ADDRESS OBJECTS         *)
(***********************************)

firstName = string ;
lastName  = string ;

address1  = string ;
address2  = string ;
address3  = string ;

city     = string ;
state    = string ;
zip      = string ;
country  = string ;

foo1 = string ;
foo2 = string ;

address =
      firstName + lastName
    + address1
    + city + state + zip + country
    + [ address2 ] + [ address3 ]
    + [ foo1 ] + [ foo2 ] ;

recipientAddressSource =
      recipientAddressBySingle
    | recipientAddressByList
    | recipientAddressByAddressId
    | recipientAddressByListId ;

recipientAddressBySingle =
    [ mappingId ] + singleAddress + [ addressName ] ;

recipientAddressByList =
    [ mappingId ] + addressList + [ addressListName ] ;

recipientAddressByListId =
    addressListId ;

recipientAddressByAddressId =
    addressId ;

mappingId = id ;
addressName = string ;
addressListName = string ;
addressListId = id ;
addressId = id ;

singleAddress = address ;
addressList   = { address } ;

(***********************************)
(*        DOCUMENT SOURCE MODES     *)
(***********************************)

documentIdSource = documentId ;
documentId = id ;

requestIdSource = requestId + [ filename ] ;
requestId = id ;
filename = string ;

urlSource = url ;
url = string ;

zipDocumentIdSource = zipDocumentId + filename ;
zipDocumentId = id ;

zipRequestIdSource = requestId + zipFilename + filename ;
zipFilename = string ;

(* Zip file reference without filename - for multi/zip top-level *)
zipDocumentIdOnly = zipDocumentId ;
zipRequestIdOnly = requestId ;

zipDocumentSource =
      zipDocumentIdSource
    | zipRequestIdSource ;

(* Translator note:
   - docSourceStandard/docSourceZipFile/docSourceAll are specialized document source variants used to keep
     endpoint schemas tight (only accepting the source types each endpoint supports).
   - zipDocumentSource is used only by /jobs/submit/multi/zip/addressCapture and is intentionally zip-only.
   - Zip-only behavior for /jobs/submit/multi/zip is enforced indirectly via multiZipJobItem using docSourceZipFile.
*)

docSourceStandard = documentIdSource | requestIdSource | urlSource ;
docSourceZipFile  = zipDocumentIdSource | zipRequestIdSource ;
docSourceZipFileRef = zipDocumentIdOnly | zipRequestIdOnly ;  (* For multi/zip top-level - zip reference without filename *)
docSourceAll      = docSourceStandard | docSourceZipFile ;

(***********************************)
(*           MERGE DOCUMENTS        *)
(***********************************)

mergeDocumentSource = documentsToMerge ;
documentsToMerge = { mergeDocumentRef } ;

mergeDocumentRef =
      mergeByDocumentId
    | mergeByRequestId ;

mergeByDocumentId = documentId ;
mergeByRequestId  = requestId + [ filename ] ;

(***********************************)
(*              JOB LISTS           *)
(***********************************)

multiDocJobs = { multiDocJobItem } ;

multiDocJobItem =
      [ jobTemplate ]
    + docSourceAll
    + recipientAddressSource ;

pdfSplitJobsWithAddress = { pdfSplitJobItemWithAddress } ;
pdfSplitJobsNoAddress   = { pdfSplitJobItemNoAddress } ;

pdfSplitJobItemWithAddress = [ jobTemplate ] + startPage + endPage + recipientAddressSource ;
pdfSplitJobItemNoAddress   = startPage + endPage ;

startPage = integer ;
endPage   = integer ;

(* Zip-only jobs list:
   - Used by POST /jobs/submit/multi/zip.
   - Zip file specified at top-level (docSourceZipFileRef in submitMultiZipParams).
   - Each item specifies optional jobTemplate, filename (which file within zip), and recipient.
   - Each job is independent with its own template and recipient.
*)
multiZipJobs = { multiZipJobItem } ;
multiZipJobItem = [ jobTemplate ] + filename + recipientAddressSource ;

(***********************************)
(*           PRIMITIVE ALIASES      *)
(***********************************)

id = integer ;

(********************************)
(*          PAYMENT DETAILS       *)
(********************************)

paymentDetails =
      creditCardPayment
    | invoicePayment
    | achPayment
    | userCreditPayment
(*  | applePayPayment   -- commented out for initial testing *)
(*  | googlePayPayment  -- commented out for initial testing *)
    ;

creditCardPayment =
      "creditCard"
    + creditCardDetails ;

invoicePayment =
      "invoice"
    + invoiceDetails ;

achPayment =
      "ach"
    + achDetails ;

userCreditPayment =
      "userCredit"
    + creditAmount ;

(*
applePayPayment =
      "applePay"
    + applePayDetails ;

googlePayPayment =
      "googlePay"
    + googlePayDetails ;
*)

creditCardDetails =
      cardType
    + cardNumber
    + expirationDate
    + cvv ;

invoiceDetails =
      invoiceNumber
    + amountDue ;

achDetails =
      routingNumber
    + accountNumber
    + checkDigit ;

creditAmount =
      amount
    + currency ;

currency = "USD" | "EUR" | "GBP" | "CAD" | "AUD" ;
amount = number ;

cardNumber = string ;
expirationDate = month + year ;
month = integer ;
year = integer ;
cvv = integer ;
routingNumber = string ;
accountNumber = string ;
checkDigit = integer ;
invoiceNumber = string ;
amountDue = number ;

cardType =
      "visa"
    | "mastercard"
    | "discover"
    | "americanExpress" ;

(********************************)
(*      APPLE PAY (TOKENIZED)       *)
(* Apple Pay definitions intentionally commented out for initial testing *)
(********************************)

(*
applePayDetails =
      applePayToken
    + [ transactionAmount ]
    + [ currencyCode ]
    + [ billingContact ] ;

applePayToken =
      paymentData
    + paymentMethod
    + transactionIdentifier ;

paymentData = string ;

paymentMethod =
      displayName
    + network
    + cardTypeApplePay ;

displayName = string ;
network = string ;
cardTypeApplePay = "debit" | "credit" | "prepaid" | "store" ;
transactionAmount = number ;
currencyCode = "USD" | "EUR" | "GBP" | "CAD" | "AUD" ;
transactionIdentifier = string ;

billingContact =
      [ givenName ]
    + [ familyName ]
    + [ emailAddress ]
    + [ phoneNumber ]
    + [ addressLines ]
    + [ locality ]
    + [ administrativeArea ]
    + [ postalCode ]
    + [ countryCode ] ;

givenName = string ;
familyName = string ;
emailAddress = string ;
phoneNumber = string ;
addressLines = { string } ;
locality = string ;
administrativeArea = string ;
postalCode = string ;
countryCode = string ;
*)

(* paymentData is Base64-encoded encrypted payment data from Apple Pay - forward to payment gateway *)

(********************************)
(*      GOOGLE PAY (TOKENIZED)     *)
(* Google Pay definitions intentionally commented out for initial testing *)
(********************************)

(*
googlePayDetails =
      paymentMethodData
    + [ transactionAmount ]
    + [ currencyCode ]
    + [ billingAddress ]
    + [ email ] ;

paymentMethodData =
      description
    + type
    + info
    + tokenizationData ;

description = string ;
type = "CARD" | "BANK" ;

info =
      cardNetwork
    + cardDetails ;

cardNetwork = "VISA" | "MASTERCARD" | "AMEX" | "DISCOVER" ;
cardDetails = string ;

tokenizationData =
      tokenizationType
    + token ;

tokenizationType = "PAYMENT_GATEWAY" | "DIRECT" ;
token = string ;

billingAddress =
      [ name ]
    + [ address1 ]
    + [ address2 ]
    + [ address3 ]
    + [ locality ]
    + [ administrativeArea ]
    + [ postalCode ]
    + [ countryCode ]
    + [ phoneNumber ]
    + [ sortingCode ] ;

name = string ;
email = string ;
sortingCode = string ;
*)

(* token is Encrypted payment token from Google Pay *)

(* ================================================================
   SUCCESS RESPONSE SCHEMAS
   ================================================================ *)

(* Standard Success Response - returned for all successful job submissions *)
standardResponse = status + message + requestId ;

status = string ;    (* e.g. "accepted" *)
message = string ;   (* Human-readable confirmation, e.g. "Your request has been queued" *)

(* ================================================================
   ERROR RESPONSE SCHEMAS
   ================================================================ *)

(* Standard Error Response - returned for all error conditions *)
errorResponse =
      errorType
    + errorMessage
    + errorCode
    + [ errorDetails ]
    + [ errorTrackingId ] ;

errorType = "ValidationError"
          | "AuthenticationError"
          | "AuthorizationError"
          | "ResourceNotFoundError"
          | "ServerError" ;

errorMessage = string ;  (* Human-readable error description *)

errorCode = "MISSING_REQUIRED_FIELD"
          | "INVALID_ONEOF"
          | "INVALID_JSON"
          | "MISSING_AUTH_HEADER"
          | "INVALID_TOKEN"
          | "EXPIRED_TOKEN"
          | "INSUFFICIENT_PERMISSIONS"
          | "ACCOUNT_SUSPENDED"
          | "JOB_NOT_FOUND"
          | "RESOURCE_NOT_FOUND"
          | "INVALID_ENUM_VALUE"
          | "MUTUAL_EXCLUSION_VIOLATION"
          | "INVALID_FORMAT"
          | "SERVER_ERROR"
          | "DATABASE_ERROR"
          | "EXTERNAL_SERVICE_ERROR" ;

errorDetails = string ;  (* JSON object with error context - additionalProperties in OpenAPI *)

errorTrackingId = string ;  (* Optional request ID for support tracking - format: TRK-YYYYMMDD-XXXXXX *)

(* HTTP Error Response Aliases *)
HTTP_400_BAD_REQUEST = errorResponse ;
HTTP_401_UNAUTHORIZED = errorResponse ;
HTTP_403_FORBIDDEN = errorResponse ;
HTTP_404_NOT_FOUND = errorResponse ;
HTTP_422_UNPROCESSABLE_ENTITY = errorResponse ;
HTTP_500_INTERNAL_SERVER_ERROR = errorResponse ;
